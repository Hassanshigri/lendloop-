# ---- Next.js (.env.local) -------------------------------------------------
# Written by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
# From the Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex (set with `npx convex env set NAME value`, never committed) ----
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# N8N_SHARED_SECRET=<same value as LENDLOOP_SHARED_SECRET below, 32+ chars>
# N8N_BASE_URL=http://localhost:5678
# ADMIN_EMAILS=you@example.com

# ---- n8n (.env next to docker-compose.yml) --------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LENDLOOP_SHARED_SECRET=
# Convex HTTP actions URL. Local: http://host.docker.internal:3211  Cloud: https://<name>.convex.site
CONVEX_SITE_URL=
# Encrypts n8n's stored credentials. Generate the same way as above.
N8N_ENCRYPTION_KEY=
